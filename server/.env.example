# Server Konfiguration
PORT=3000
NODE_ENV=production

# Sicherheit & Authentifizierung
# Generiere einen sicheren 64-Zeichen Key: openssl rand -hex 32
JWT_SECRET=dein-sehr-sicherer-geheimer-jwt-schluessel-fuer-produktion
JWT_EXPIRES_IN=7d

# Standard-Administrator Initial-Passwort (wird beim ersten Start gehasht)
ADMIN_DEFAULT_PASSWORD=AstraAdmin2026!Sicher

# Datenverzeichnis (für Coolify / Docker Persistent Storage)
DATA_DIR=/app/data

# CORS Konfiguration (z. B. * oder spezifische Domains)
CORS_ORIGIN=*
